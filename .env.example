# WordPress test environment
COMPOSE_PROJECT_NAME=sams-integration

# WordPress
WP_PORT=8080
WP_DEBUG=1
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# Database
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# SAMS API key (recommended: set here, never commit .env)
# Global key used for all sources:
SIK_API_KEY=

# Optional: source-specific override by source id, example source id "sams-v2"
SIK_API_KEY_SAMS_V2=

# Optional helper for dynamic source constant generation in wp-config-extra
SIK_SOURCE_ID=sams-v2
