# WordPress test environment
COMPOSE_PROJECT_NAME=easy-sams

# WordPress
WP_PORT=8080
WP_DEBUG=1
WP_DEBUG_LOG=1
WP_DEBUG_DISPLAY=0
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# WordPress admin account (used for automatic setup via WP-CLI)
WP_TITLE=[dev] Easy SAMS
WP_ADMIN_USER=test
WP_ADMIN_PASSWORD=test
WP_ADMIN_EMAIL=admin@example.local

# Database
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# Plugin Check
PLUGIN_CHECK_SKIP_INSTALL=0  # 1 = skip installation, 0 = install

# SAMS API key (recommended: set here, never commit .env)
# Global key used for all sources:
ESAMS_API_KEY=

# Optional: source-specific override by source id, example source id "sams-v2"
ESAMS_API_KEY_SAMS_V2=

# Optional helper for dynamic source constant generation in wp-config-extra
ESAMS_SOURCE_ID=sams-v2

# Demo page: pre-fill block configuration (UUIDs from SAMS backend)
# Leave empty to show the block's "please configure" placeholder
ESAMS_SEASON_UUID=
ESAMS_LEAGUE_UUID=
ESAMS_TEAM_UUID=
